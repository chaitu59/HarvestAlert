
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --green: #176b4d;
  --deep: #123d30;
  --light: #eaf5ed;
  --bg: #f5f8f5;
  --text: #1b3028;
  --muted: #718078;
  --line: #e4ebe6;
  --white: #fff;
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 14px 'DM Sans', sans-serif;
}
a { text-decoration: none; color: inherit; }
.sidebar {
  width: 245px; position: fixed; inset: 0 auto 0 0;
  padding: 27px 17px; background: white;
  border-right: 1px solid var(--line); display: flex;
  flex-direction: column; z-index: 5;
}
.brand {
  font: 800 21px Manrope, sans-serif; letter-spacing: -.7px;
  padding: 0 8px 35px;
}
.brand span { color: var(--green); }
.nav-label, .eyebrow, .tool-card small {
  font-size: 10px; font-weight: 700; letter-spacing: 1.4px;
  color: #98a69d;
}
.nav-label { padding: 0 10px 12px; }
nav { display: grid; gap: 5px; }
nav a {
  padding: 13px 12px; border-radius: 10px; color: #728078;
  font-weight: 600; transition: .2s;
}
nav a:hover, nav a.active { background: var(--light); color: var(--green); }
.side-note {
  margin-top: auto; background: #f1f7f2; border: 1px solid var(--line);
  padding: 17px; border-radius: 14px;
}
.side-note span { font-size: 24px; }
.side-note h3 { font: 800 13px Manrope; }
.side-note p { font-size: 11px; color: var(--muted); line-height: 1.7; }
.side-footer { color: #9aa69e; font-size: 9px; letter-spacing: 1px; padding: 20px 5px 0; }
.main { margin-left: 245px; padding: 32px 36px; max-width: 1600px; }
.topbar { display: flex; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 25px; }
h1 { font: 800 29px Manrope; letter-spacing: -1px; margin: 7px 0; }
h2 { font: 800 18px Manrope; letter-spacing: -.4px; margin: 0 0 6px; }
h3 { font: 800 15px Manrope; margin: 10px 0 7px; }
p { line-height: 1.65; }
.muted { color: var(--muted); font-size: 12px; margin: 0; }
.status { font-size: 12px; color: var(--green); background: var(--light); padding: 10px 13px; border-radius: 20px; }
.hero {
  min-height: 235px; border-radius: 20px; overflow: hidden;
  position: relative; padding: 33px 38px; color: white;
  background: linear-gradient(110deg, #154b38, #21845d);
  margin-bottom: 30px;
}
.hero-content { position: relative; z-index: 2; max-width: 480px; }
.tag { font-size: 9px; letter-spacing: 1.5px; font-weight: 700; background: #ffffff20; padding: 8px 11px; border-radius: 20px; }
.hero h2 { font-size: 31px; line-height: 1.2; margin-top: 17px; }
.hero p { color: #d5e9db; max-width: 380px; font-size: 12px; }
.button {
  display: inline-flex; justify-content: center; align-items: center;
  border: 0; border-radius: 9px; padding: 12px 16px;
  font: 700 12px 'DM Sans'; cursor: pointer; transition: .2s;
}
.button:hover { transform: translateY(-1px); }
.white-button { background: white; color: var(--green); margin-top: 8px; }
.primary-button { background: var(--green); color: white; }
.primary-button:hover { background: #10553c; }
.hero-art { position: absolute; inset: 0 0 0 54%; opacity: .9; }
.sun { position: absolute; width: 65px; height: 65px; border-radius: 50%; background: #f7d37e; right: 25%; top: 25px; }
.hill { position: absolute; bottom: -70px; width: 350px; height: 180px; border-radius: 50% 50% 0 0; }
.hill-a { right: -40px; background: #2d8a5b; transform: rotate(-7deg); }
.hill-b { right: 140px; bottom: -95px; background: #5eaa70; }
.plant { position: absolute; color: #c6e7a5; font-size: 58px; bottom: 25px; }
.plant-a { right: 25%; }
.plant-b { right: 10%; bottom: 40px; }
.section-title { display: flex; justify-content: space-between; align-items: center; gap: 15px; margin: 0 0 16px; }
.count { font-size: 9px; font-weight: 700; letter-spacing: 1px; color: var(--green); background: var(--light); padding: 8px 10px; border-radius: 8px; }
.tool-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 15px; }
.tool-card, .panel, .resource-card {
  background: white; border: 1px solid var(--line); border-radius: 15px;
  box-shadow: 0 10px 30px #15433009;
}
.tool-card { padding: 20px; transition: .2s; }
.tool-card:hover, .resource-card:hover { transform: translateY(-3px); border-color: #b8d7c2; }
.tool-icon { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; margin-bottom: 15px; }
.gold { background: #fff3d7; color: #b27a0d; }
.blue { background: #e5f1fb; color: #3877b9; }
.green { background: #e5f4e9; color: #258052; }
.pink { background: #fbe9ed; color: #c45e78; }
.earth { background: #f3ebdc; color: #9b7545; }
.purple { background: #eee9fb; color: #7962bd; }
.tool-card small { display: block; }
.tool-card h3 { margin-top: 9px; }
.tool-card p, .resource-card p { color: #78857d; font-size: 12px; line-height: 1.7; }
.tool-card b, .resource-card b { font-size: 11px; color: var(--green); }
.panel { padding: 23px; margin-top: 24px; }
.form-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
label { display: flex; flex-direction: column; gap: 8px; color: #506158; font-size: 12px; font-weight: 700; }
input, select, textarea {
  width: 100%; min-width: 0; border: 1px solid #dce6df;
  background: white; border-radius: 9px; padding: 12px;
  font: 400 12px 'DM Sans'; color: var(--text); outline: none;
}
input:focus, select:focus, textarea:focus { border-color: #4b9c70; box-shadow: 0 0 0 3px #e7f4eb; }
.form-grid button { align-self: end; min-height: 40px; }
.result { padding: 15px; border-radius: 10px; background: #f1f8f2; border: 1px solid #dcece0; margin-top: 17px; line-height: 1.7; }
.hidden { display: none !important; }
.page-intro { display: flex; align-items: center; gap: 15px; margin: 10px 0 22px; }
.page-intro .tool-icon { margin: 0; width: 53px; height: 53px; font-size: 25px; }
.panel > p { color: var(--muted); font-size: 12px; }
.inline-form { display: flex; align-items: end; gap: 12px; }
.inline-form label { flex: 1; }
.forecast-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px; margin-top: 18px; }
.forecast-card { text-align: center; border: 1px solid var(--line); background: white; border-radius: 12px; padding: 14px 8px; }
.forecast-card strong { font-size: 12px; }
.forecast-card .weather-icon { font-size: 25px; margin: 10px; }
.forecast-card small { display: block; color: var(--muted); font-size: 10px; line-height: 1.6; margin-top: 8px; }
.stats { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; margin-top: 14px; }
.stat { padding: 13px; border: 1px solid var(--line); border-radius: 10px; background: white; }
.stat small { display: block; color: var(--muted); margin-bottom: 7px; }
.stat strong { color: var(--green); font: 800 16px Manrope; overflow-wrap: anywhere; }
.info-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; margin-top: 18px; }
.info { background: white; border: 1px solid var(--line); border-radius: 14px; padding: 19px; }
.info p { color: var(--muted); font-size: 12px; }
.warning { background: #fff8ec; border: 1px solid #f2e5cc; border-radius: 10px; padding: 13px; margin-top: 18px; color: #8a7560; font-size: 11px; line-height: 1.7; }
.resource-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; }
.resource-card { display: flex; gap: 14px; padding: 18px; transition: .2s; }
.resource-card .tool-icon { flex-shrink: 0; }
footer { display: flex; justify-content: space-between; gap: 10px; padding: 25px 2px 8px; color: #9aa69e; font-size: 10px; }
@media (max-width: 1100px) {
  .sidebar { width: 215px; }
  .main { margin-left: 215px; padding: 25px 22px; }
  .tool-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .hero-art { left: 48%; }
}
@media (max-width: 700px) {
  .sidebar { position: relative; width: 100%; padding: 16px 13px 10px; border-right: 0; border-bottom: 1px solid var(--line); }
  .brand { display: block; padding: 0 5px 15px; }
  .nav-label, .side-note, .side-footer { display: none; }
  nav { display: flex; overflow-x: auto; gap: 5px; }
  nav a { white-space: nowrap; padding: 10px; font-size: 11px; }
  .main { margin: 0; padding: 20px 14px; }
  .topbar { align-items: flex-start; }
  h1 { font-size: 24px; }
  .status { display: none; }
  .hero { padding: 25px 21px; min-height: 255px; }
  .hero h2 { font-size: 26px; }
  .hero-art { left: 25%; opacity: .35; }
  .tool-grid, .info-grid, .resource-grid { grid-template-columns: 1fr; }
  .form-grid, .stats { grid-template-columns: 1fr; }
  .form-grid button { width: 100%; }
  .forecast-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .inline-form { flex-direction: column; align-items: stretch; }
  .inline-form button { width: 100%; }
  .panel { padding: 17px; }
  footer { flex-direction: column; }
}
