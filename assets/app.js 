
const $ = id => document.getElementById(id);
const money = n => new Intl.NumberFormat('en-IN', {
  style: 'currency', currency: 'INR', maximumFractionDigits: 0
}).format(n);

const showResult = (id, html) => {
  const el = $(id);
  if (!el) return;
  el.innerHTML = html;
  el.classList.remove('hidden');
};

const escapeHTML = value => String(value ?? '').replace(/[&<>"']/g, c => ({
  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
}[c]));

// Dashboard farm profile
if ($('profile-form')) {
  $('profile-form').addEventListener('submit', e => {
    e.preventDefault();
    const name = $('farm-name').value.trim() || 'My farm';
    const crop = $('farm-crop').value || 'Not specified';
    const area = $('farm-area').value || 'Not specified';
    showResult('profile-result',
      `<b>Farm profile</b><p>${escapeHTML(name)} · ${escapeHTML(crop)} · ${escapeHTML(area)} acres</p>`);
  });
}

// Weather: real forecast from Open-Meteo
if ($('weather-form')) {
  const form = $('weather-form');
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const location = $('location').value.trim();
    const status = $('weather-status');
    const grid = $('forecast-grid');
    status.textContent = 'Loading forecast…';
    grid.innerHTML = '';

    try {
      const geoResponse = await fetch(
        'https://geocoding-api.open-meteo.com/v1/search?name=' +
        encodeURIComponent(location) + '&count=1&language=en&format=json'
      );
      if (!geoResponse.ok) throw new Error('Location search failed.');
      const geo = await geoResponse.json();
      if (!geo.results?.length) throw new Error('Location not found. Try another nearby town.');

      const place = geo.results[0];
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${place.latitude}&longitude=${place.longitude}&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=auto&forecast_days=7`;
      const response = await fetch(url);
      if (!response.ok) throw new Error('Forecast service is unavailable.');
      const data = await response.json();

      status.textContent = `Seven-day forecast for ${place.name}${place.admin1 ? ', ' + place.admin1 : ''}.`;
      const icon = code => code === 0 ? '☀️' :
        [1,2,3].includes(code) ? '⛅' :
        [45,48].includes(code) ? '🌫️' :
        [51,53,55,61,63,65,80,81,82].includes(code) ? '🌧️' : '⛈️';

      grid.innerHTML = data.daily.time.map((date, i) => `
        <article class="forecast-card">
          <strong>${new Date(date + 'T12:00:00').toLocaleDateString('en-IN',
            {weekday:'short', day:'numeric', month:'short'})}</strong>
          <div class="weather-icon">${icon(data.daily.weather_code[i])}</div>
          <b>${Math.round(data.daily.temperature_2m_max[i])}° /
              ${Math.round(data.daily.temperature_2m_min[i])}°</b>
          <small>Rain chance: ${data.daily.precipitation_probability_max?.[i] ?? '—'}%</small>
        </article>`).join('');
    } catch (error) {
      status.textContent = error.message || 'Could not load weather. Check your internet.';
    }
  });
}

// Water-risk screening score
if ($('risk-form')) {
  $('risk-form').addEventListener('submit', e => {
    e.preventDefault();
    const form = new FormData(e.target);
    const score = ['moisture','rain','heat','irrigation','stage']
      .reduce((sum, key) => sum + Number(form.get(key) || 0), 0);
    const level = score <= 5 ? 'Lower screening concern' :
      score <= 11 ? 'Moderate screening concern' : 'Higher screening concern';

    showResult('risk-result', `
      <h3>${level}</h3>
      <div class="stats">
        <div class="stat"><small>Screening score</small><strong>${score}/19</strong></div>
        <div class="stat"><small>First check</small><strong>Root-zone soil</strong></div>
        <div class="stat"><small>Next step</small><strong>${score > 11 ? 'Inspect promptly' : 'Keep monitoring'}</strong></div>
      </div>
      <p>${score > 11
        ? 'Inspect soil moisture and crop condition promptly. Ask a local agricultural expert about irrigation priorities.'
        : 'Continue checking soil moisture, rainfall and crop condition, especially during sensitive growth stages.'}</p>
      <p><small>This is an illustrative screening score, not an official drought forecast.</small></p>`);
  });
}

// Harvest calculator
if ($('harvest-form')) {
  $('harvest-form').addEventListener('submit', e => {
    e.preventDefault();
    const f = new FormData(e.target);
    const area = Number(f.get('area'));
    const yieldPerAcre = Number(f.get('yield'));
    const price = Number(f.get('price'));
    const cost = Number(f.get('cost'));
    const reduction = Number(f.get('reduction'));

    if (![area, yieldPerAcre, price, cost].every(Number.isFinite) ||
        area <= 0 || yieldPerAcre < 0 || price < 0 || cost < 0) {
      showResult('harvest-result', '<p>Please enter valid numbers.</p>');
      return;
    }

    const quantity = area * yieldPerAcre * (1 - reduction / 100);
    const revenue = quantity * price;
    const balance = revenue - cost;

    showResult('harvest-result', `
      <h3>Your harvest estimate</h3>
      <div class="stats">
        <div class="stat"><small>Estimated quantity</small><strong>${quantity.toFixed(2)} q</strong></div>
        <div class="stat"><small>Gross revenue</small><strong>${money(revenue)}</strong></div>
        <div class="stat"><small>Revenue minus costs</small><strong>${money(balance)}</strong></div>
      </div>
      <p>This estimate uses your inputs and is not a guaranteed yield or profit.`);
  });
}

// Crop photo preview and observation summary
if ($('crop-photo')) {
  $('crop-photo').addEventListener('change', e => {
    const file = e.target.files[0];
    const preview = $('photo-preview');
    preview.innerHTML = '';
    if (!file) {
      preview.textContent = 'No photo selected.';
      return;
    }
    if (!file.type.startsWith('image/')) {
      preview.textContent = 'Please choose an image file.';
      return;
    }
    const img = document.createElement('img');
    img.alt = 'Selected crop photo preview';
    img.src = URL.createObjectURL(file);
    preview.appendChild(img);
  });
}

if ($('crop-form')) {
  $('crop-form').addEventListener('submit', e => {
    e.preventDefault();
    const form = new FormData(e.target);
    const symptoms = form.getAll('symptom');
    showResult('crop-result', `
      <h3>Crop observation summary</h3>
      <p><b>Crop:</b> ${escapeHTML(form.get('crop'))}</p>
      <p><b>Growth stage:</b> ${escapeHTML(form.get('stage'))}</p>
      <p><b>Symptoms:</b> ${symptoms.length ? symptoms.map(escapeHTML).join(', ') : 'None selected'}</p>
      <p><b>Notes:</b> ${escapeHTML(form.get('notes') || 'No extra notes')}</p>
      <p>Share these observations and photos with a local agricultural officer. This tool does not diagnose crop disease.</p>`);
  });
}

// Soil advisor
if ($('soil-form')) {
  $('soil-form').addEventListener('submit', e => {
    e.preventDefault();
    const f = new FormData(e.target);
    const tips = [];
    const soil = f.get('soil');
    const condition = f.get('condition');

    const soilTips = {
      black: 'Black or clay-rich soil may hold water for longer. Avoid working it while very wet and monitor drainage.',
      red: 'Red soils vary in fertility and texture. A soil test helps identify nutrient and pH requirements.',
      sandy: 'Sandy soils may drain quickly. Ask about locally suitable organic matter and irrigation practices.',
      loamy: 'Loamy soil often has a useful balance of drainage and water retention; maintain organic matter.',
      unknown: 'If unsure of soil type, ask a local agriculture office about soil testing.'
    };
    tips.push(soilTips[soil]);

    if (condition === 'dry') tips.push('Check moisture near the crop roots and consider locally recommended moisture-conservation practices.');
    if (condition === 'wet') tips.push('If water remains for a long time, check drainage and ask a local expert about crop-specific options.');
    if (condition === 'poor') tips.push('Poor growth can have several causes. Do not guess fertilizer doses; check for pests, water stress and nutrient issues.');
    if (condition === 'normal') tips.push('Keep monitoring crop growth, soil moisture and field conditions.');

    tips.push(f.get('test') === 'yes'
      ? 'Follow your soil-test report and crop-specific recommendations.'
      : 'Consider a soil test before deciding on fertilizer amounts.');

    showResult('soil-result', `<h3>General soil guidance</h3><ul>${tips.map(t => `<li>${escapeHTML(t)}</li>`).join('')}</ul><p>Confirm crop-specific recommendations with a local agricultural expert.</p>`);
  });
}
